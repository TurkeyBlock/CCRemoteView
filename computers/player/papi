-- papi: playerComputer API
-- Analogous to tapi for turtleComputers.
-- Provides shared state, HTTP/modem helpers, and the stop-signal semaphore.

-- !MUST END WITH '/'
-- %%APP_URL%% is replaced by the server before this file is served; not valid Lua as-is.
url = "%%APP_URL%%/api/"

local api_common = dofile("/api_common.lua")

-- Stop-signal semaphore (mirrors tapi)
-- Commands that run loops should check locSemaphore.stopSignal and
-- bracket critical sections with count inc/dec.
locSemaphore = {
    stopSignal = false,
    count      = 0,
}


-- ─── GPS helpers ─────────────────────────────────────────────

-- Returns x, y, z from GPS, or nil if unavailable.
function get_location()
    local x, y, z = gps.locate(2)   -- 2-second timeout
    if x then return x, y, z end
    return nil, nil, nil
end

-- ─── Status / result helpers (HTTP) ──────────────────────────

function send_status_update()
    local x, y, z = get_location()
    local payload = {
        id   = os.getComputerID(),
        type = "player",
        loc  = x and { x = math.floor(x), y = math.floor(y), z = math.floor(z) } or nil,
    }
    local json = textutils.serializeJSON(payload)
    local res  = http.post(url .. "statusUpdate", json,
                           { ["Content-Type"] = "application/json" })
    if res then res.close() end
end

local _ws = api_common.make_ws_sender(url, { ["Content-Type"] = "application/json" })
set_ws              = _ws.set_ws
send_command_result = _ws.send_command_result


-- ─── Scan helper ─────────────────────────────────────────────

local SCAN_INCLUDE_METADATA = true
local SCAN_INCLUDE_STATE    = false

function scan()
    local neural = peripheral.find("neuralInterface")
    if not neural then
        print("! scan: no neuralInterface peripheral found")
        return false, "no neural interface found"
    end
    if not neural.scan then
        print("! scan: neural interface has no scan method (scanner module not equipped?)")
        return false, "no scanner module equipped"
    end

    local x, y, z = get_location()
    if not x then
        print("! scan: GPS fix failed")
        return false, "GPS fix failed"
    end

    local raw    = neural.scan(4)
    local blocks = {}
    for _, b in ipairs(raw) do
        local entry = { x = b.x, y = b.y, z = b.z, name = b.name }
        if SCAN_INCLUDE_METADATA then entry.metadata = b.metadata end
        if SCAN_INCLUDE_STATE and b.state and next(b.state) then
            entry.state = b.state
        end
        table.insert(blocks, entry)
    end

    local ox, oy, oz = math.floor(x), math.floor(y), math.floor(z)
    local payload = {
        id     = os.getComputerID(),
        origin = { x = ox, y = oy, z = oz },
        blocks = blocks,
    }

    local json = textutils.serializeJSON(payload)
    local res  = http.post(url .. "scan", json,
        { ["Content-Type"] = "application/json" })
    if not res then
        print("! scan: HTTP request failed")
        return false, "http request failed"
    end
    local code = res.getResponseCode()
    local body = res.readAll()
    res.close()
    if code ~= 200 then
        print("! scan failed (HTTP " .. code .. "): " .. tostring(body))
        return false, "server error: " .. code
    end
    print("? block scan (" .. #blocks .. " blocks @ " .. ox .. "," .. oy .. "," .. oz .. ")")
    return true
end
