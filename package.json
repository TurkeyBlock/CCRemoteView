{
  "name": "ccturtleremotecontroller",
  "private": true,
  "version": "1.2.1",
  "bin": "src/server/server.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "NODE_ENV=production node src/server/server.js",
    "server:dev": "node src/server/server.js",
    "dev:all": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "test:turtle": "node utils/testTurtle.js",
    "build-textures": "node utils/textureExtractor/textureExtractor.js",
    "pkg": "npm run build && pkg package.json && node utils/zipPackaged.js"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "camera-controls": "1.34.2",
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.22.1",
    "http-terminator": "3.2.0",
    "math3d": "0.2.2",
    "pinia": "2.0.12",
    "simple-node-logger": "21.8.12",
    "three": "0.138.3",
    "vue": "3.2.25",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/three": "0.138.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.1",
    "minecraft-blocks-render": "1.1.1",
    "pkg": "^5.8.1",
    "typescript": "4.5.4",
    "unzipper": "0.10.11",
    "vite": "^8.0.3",
    "vue-tsc": "0.29.8"
  },
  "pkg": {
    "outputPath": "packaged"
  }
}
