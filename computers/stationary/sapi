-- sapi: stationaryComputer API
-- Analogous to capi. Location is captured once on boot and reused.

-- !MUST END WITH '/'
-- %%APP_URL%% is replaced by the server before this file is served; not valid Lua as-is.
url = "%%APP_URL%%/api/"

use_modem       = false
MODEM_SERVER_ID = 0

-- Populated once at boot by init_location()
loc = nil   -- { x, y, z } or nil if GPS unavailable

-- Stop-signal semaphore
locSemaphore = {
    stopSignal = false,
    count      = 0,
}

local headers        = { ["Content-Type"] = "application/json" }
local api_common     = require("api_common")  -- shared library downloaded to disk during startup

-- ─── Boot-time location capture ──────────────────────────────

-- Call once from startup before launching rcStationary.
-- Retries until a GPS fix is obtained or max_attempts is reached.
function init_location(max_attempts)
    max_attempts = max_attempts or 10
    for i = 1, max_attempts do
        local x, y, z = gps.locate(2)
        if x then
            loc = { x = x, y = y, z = z }
            print("GPS fix: " .. x .. ", " .. y .. ", " .. z)
            return true
        end
        print("GPS attempt " .. i .. "/" .. max_attempts .. " failed, retrying...")
        os.sleep(2)
    end
    print("Warning: GPS unavailable — loc will be nil")
    return false
end

-- ─── Modem setup ─────────────────────────────────────────────

local _m = api_common.make_modem(url)
use_modem = _m.use_modem
local modem_device = _m.modem_device

-- ─── Status / result helpers ──────────────────────────────────

function send_status_update()
    local payload = {
        id                   = os.getComputerID(),
        type                 = "stationary",
        loc                  = loc,
        has_modem_peripheral = modem_device ~= nil,
    }
    local json = textutils.serializeJSON(payload)
    local res  = http.post(url .. "statusUpdate", json, headers)
    if res then res.close() end
end

local _ws = api_common.make_ws_sender(url, headers)
set_ws              = _ws.set_ws
send_command_result = _ws.send_command_result


-- ─── Chat helper ─────────────────────────────────────────────

function send_chat(player, message, uuid)
    local data = {
        id      = os.getComputerID(),
        player  = player,
        message = message,
        uuid    = uuid or "",
    }
    local json = textutils.serializeJSON(data)
    local res  = http.post(url .. "chat", json, headers)
    if res then res.close() end
end

-- ─── Sense helper ────────────────────────────────────────────

function sense()
    local sensor = peripheral.find("plethora:sensor")
    if not sensor then return false, "no plethora:sensor attached" end

    local raw      = sensor.sense()
    local entities = {}
    for _, e in ipairs(raw) do
        table.insert(entities, {
            id   = e.id,
            name = e.name,
            x    = e.x,
            y    = e.y,
            z    = e.z,
        })
    end

    local payload = { id = os.getComputerID(), entities = entities }
    if loc then payload.origin = loc end

    local json = textutils.serializeJSON(payload)
    local res  = http.post(url .. "sense", json, headers)
    if res then res.close() end

    print("? entity scan (" .. #entities .. " entities)")
    return true
end

-- ─── Chat send helper ────────────────────────────────────────

function get_chat_message()
    local data = { id = os.getComputerID() }
    local json = textutils.serializeJSON(data)
    local res  = http.post(url .. "getChatMessage", json, headers)
    if res then
        local body = res.readAll()
        res.close()
        if body and body ~= "" then return body end
    end
    return nil
end

-- ─── Say helper ──────────────────────────────────────────────

function say(message)
    local chat = peripheral.find("plethora:chat")
    if not chat then return false, "no chat recorder attached" end
    chat.say(message)
    return true
end
