-- Modem Server startup

-- !MUST END WITH '/'
-- %%APP_URL%% is replaced by the server before this file is served; not valid Lua as-is.
base_url = "%%APP_URL%%/"

-- boot.lua is not on disk yet on first boot, so we must fetch it inline before require() can work.
local function bootstrap_download(url, dest)
    local res = http.get(url, nil)
    while not res do
        print("Error: " .. url .. " - retrying in 5s")
        sleep(5)
        res = http.get(url, nil)
    end
    local f = fs.open(dest, "w")
    f.write(res.readAll())
    f.close()
    res.close()
end

bootstrap_download(base_url .. "computers/shared/boot.lua", "/boot.lua")
local boot = dofile("/boot.lua")

boot.check_approved(base_url, "modem")
-- Modem only needs boot.lua from shared (no rc_loop/api_common — modemServer.lua manages its own HTTP). "startup" self-updates.
boot.get_files(base_url, "computers/shared/", {"boot.lua"})
boot.get_files(base_url, "computers/modem/", {"modemServer.lua", "startup"})

shell.run("modemServer.lua")
