# Environment variables for .env.local.
# Dev defaults and auth bypass are configured in src/server/config.js.

# --- Required in production ---

# Public URL this server is reachable at (used for CORS, signin redirect, and CC startup URL)
APP_URL=https://your-domain.com

# Auth.js instance this server validates JWT tokens from
NEXTAUTH_URL=https://auth.example.com
NEXTAUTH_SECRET=your-secret-here

# --- Optional overrides ---

# Port to listen on (default: 8081)
APP_PORT=8081

# Override the network bind address in production (default: 0.0.0.0)
# BIND_HOST=0.0.0.0

# Force local-only (127.0.0.1) binding in a packaged production build
# APP_LOCAL_ONLY=true

# Override verbose log suppression (default: true in production, false in dev)
# SUPPRESS_UPDATE_LOGS=true
# SUPPRESS_SAVE_LOGS=true
