-- send status to server

function send_status_update()
  scan_surrounding_blocks()
  scan_inventory()
  scan_turtle_specs()

  if ws_conn then
    ws_conn.send(textutils.serializeJSON({ type = "state", data = state }))
  else
    local json = textutils.serializeJSON(state)
    local res = http.post(state_url, json, headers)
    if res then res.close() end
  end
end

-- WebSocket connection for result delivery; nil = use HTTP (set by rcTurtle startup)
local ws_conn = nil
function set_ws(ws) ws_conn = ws end

-- Send a command result to the server.
function send_command_result(succ, ret)
  state.actionSeq = state.actionSeq + 1  -- advance so the next status update carries the updated seq
  local result
  if pcall(textutils.serializeJSON, { succ = succ, ret = ret }) then
    result = { succ = succ, ret = ret }
  else
    result = { succ = false, ret = "error: result not serializable" }
  end
  local json = textutils.serializeJSON({ type = "commandResult", computerId = os.getComputerID(), result = result })
  if ws_conn then
    print("[tapi] sending result via WS")
    ws_conn.send(json)
  else
    print("[tapi] sending result via HTTP (no ws_conn)")
    local res = http.post(url .. "commandResult", json, headers)
    if res then res.close() end
  end
end

local function does_side_have_inventory(side)
  if not peripheral.isPresent(side) then return false end
  -- hasType fast-path: if it confirms inventory, trust it.
  if peripheral.hasType and peripheral.hasType(side, "inventory") then return true end
  -- Fallback: probe by calling list(). Handles modded blocks that don't register
  -- as "inventory" type but still expose a list() method.
  local ok, result = pcall(peripheral.call, side, "list")
  return ok and type(result) == "table"
end

local function read_side_inventory(side)
  local ok, inv = pcall(peripheral.call, side, "list")
  local ok2, sz = pcall(peripheral.call, side, "size")
  if not ok or not inv then return nil, ok2 and sz or nil end
  local size = ok2 and sz or 0
  local normalized = {}
  for i = 1, size do
    normalized[i] = inv[i] or false
  end
  return normalized, size
end

function scan_surrounding_blocks()
  local succ, block = turtle.inspect();
  state.view.front = succ and block or 0
  if succ and does_side_have_inventory("front") then
    local inv, sz = read_side_inventory("front")
    if inv ~= nil then
      state.view.front.inventory = inv
      state.view.front.inventorySize = sz
    end
  end
  succ, block = turtle.inspectUp();
  state.view.top = succ and block or 0
  if succ and does_side_have_inventory("top") then
    local inv, sz = read_side_inventory("top")
    if inv ~= nil then
      state.view.top.inventory = inv
      state.view.top.inventorySize = sz
    end
  end
  succ, block = turtle.inspectDown();
  state.view.bottom = succ and block or 0
  if succ and does_side_have_inventory("bottom") then
    local inv, sz = read_side_inventory("bottom")
    if inv ~= nil then
      state.view.bottom.inventory = inv
      state.view.bottom.inventorySize = sz
    end
  end
end

-- Equip a specific item by name to the given side ("left" or "right").
-- Returns true on success, or false + error string on failure.
local function equipItem(itemName, side)
  -- Check if already equipped as a peripheral (e.g. plethora modules)
  local equipped = peripheral.getType(side)
  if equipped == itemName then return true end

  for slot = 1, 16 do
    local item = turtle.getItemDetail(slot)
    if item and item.name == itemName then
      turtle.select(slot)
      if side == "left" then
        turtle.equipLeft()
      else
        turtle.equipRight()
      end
      return true
    end
  end

  return false, "item not found in inventory: " .. itemName
end

function scan_inventory()
  for i = 1, 16 do
    local stack = turtle.getItemDetail(i)
    state.inv[i] = stack or 0
  end
  state.selectedSlot = turtle.getSelectedSlot()
end

function scan_turtle_specs()
  state.loc.x = getLoc().x
  state.loc.y = getLoc().y
  state.loc.z = getLoc().z
  state.rot = getLoc().h - 1
  state.id = os.getComputerID()
  state.label = os.getComputerLabel() or ""
  state.fuelLevel = turtle.getFuelLevel()
  state.fuelLimit = turtle.getFuelLimit()
end

