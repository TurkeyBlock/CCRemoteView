-- Minecart Computer startup

-- !MUST END WITH '/'
-- %%APP_URL%% is replaced by the server before this file is served; not valid Lua as-is.
base_url = "%%APP_URL%%/"

-- boot.lua is not on disk yet on first boot, so we must fetch it inline before require() can work.
local function bootstrap_download(url, dest)
    local res = http.get(url, nil)
    while not res do
        print("Error: " .. url .. " - retrying in 5s")
        sleep(5)
        res = http.get(url, nil)
    end
    local f = fs.open(dest, "w")
    f.write(res.readAll())
    f.close()
    res.close()
end

bootstrap_download(base_url .. "computers/shared/boot.lua", "/boot.lua")
local boot = dofile("/boot.lua")

boot.check_approved(base_url, "minecart")
-- Re-downloads shared libs (keeping boot.lua current). "startup" in the type list causes this file to self-update; new version runs on next reboot.
boot.get_files(base_url, "computers/shared/", {"boot.lua", "rc_loop.lua", "api_common.lua"})
boot.get_files(base_url, "computers/minecart/", {"capi", "rcMinecart.lua", "startup"})

os.loadAPI("capi")

print("Checking GPS...")
local x, y, z = gps.locate(5)
if not x then
    print("! GPS unavailable. Cannot start — no location fix.")
    print("Ensure GPS hosts are running and a wireless modem is attached.")
    return
end
print("GPS OK: " .. x .. ", " .. y .. ", " .. z)

shell.run("rcMinecart.lua")
