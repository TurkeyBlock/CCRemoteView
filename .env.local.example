# Production environment variables.
# Dev defaults and auth bypass are configured in src/server/config.js.

# Public URL this server is reachable at (used for CORS, signin redirect, and CC startup URL)
APP_URL=https://your-domain.com

# Port to listen on (default 8081)
APP_PORT=8081

# Auth.js instance this server validates JWT tokens from
NEXTAUTH_URL=https://auth.example.com
NEXTAUTH_SECRET=your-secret-here
