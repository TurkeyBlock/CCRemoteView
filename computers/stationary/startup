-- stationaryComputer startup
-- Downloads the latest stationaryComputer files and launches the remote control loop.

-- !MUST END WITH '/'
base_url = "%%APP_URL%%/"

local function get_files_from_server()
    local files = { "sapi", "rcStationary.lua", "startup" }
    term.write("autoupdate...")
    for _, name in ipairs(files) do
        local url = base_url .. "computers/stationary/" .. name
        local res = http.get(url, nil)
        while not res do
            print("Error on GET " .. url .. " - retrying in 5 seconds")
            sleep(5)
            res = http.get(url, nil)
        end
        local f = fs.open(name, "w")
        f.write(res.readAll())
        f.close()
        res.close()
        if name == "startup" then
            if fs.exists("backup") then
                fs.delete("backup/startup")
            else
                fs.makeDir("backup")
            end
            if fs.exists("startup") then
                fs.copy("startup", "backup/startup")
            end
        end
    end
    term.write("complete\n")
end

local function check_approved()
    while true do
        local res = http.post(
            base_url .. "api/getCommand",
            textutils.serialiseJSON({ id = os.getComputerID() }),
            { ["Content-Type"] = "application/json" }
        )
        if res then
            local code = res.getResponseCode()
            local body = textutils.unserialiseJSON(res.readAll()) or {}
            res.close()
            if code == 200 then
                return true
            elseif code == 403 then
                term.clear()
                term.setCursorPos(1, 1)
                if body.status == "pending_ip" then
                    print("Waiting for IP approval...")
                    print("Approve this computer's IP in the admin panel.")
                elseif body.status == "pending_id" then
                    print("Waiting for computer ID approval...")
                    print("IP approved. Approve computer ID "
                          .. tostring(os.getComputerID()) .. " in the admin panel.")
                else
                    print("Waiting for admin approval...")
                end
                print("Retrying in 10 seconds.")
                sleep(10)
            else
                print("Unexpected response: " .. code)
                sleep(10)
            end
        else
            print("Could not reach server, retrying...")
            sleep(5)
        end
    end
end

-- Wait for approval before downloading updates
check_approved()

-- Autoupdate
get_files_from_server()

-- Capture GPS location once before launching (sapi stores it in sapi.loc)
os.loadAPI("sapi")
sapi.init_location()

-- Launch the remote control loop
shell.run("rcStationary.lua")
